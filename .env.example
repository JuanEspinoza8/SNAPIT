# Base de datos (servicio db de docker-compose)
# La clave se fija al crear la base: cambiarla despues no tiene efecto sin docker compose down -v.
POSTGRES_USER=snapit
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=snapit
DB_PORT=5432

# Conexion que va a usar Prisma (#2)
# DATABASE_URL y TEST_DATABASE_URL repiten usuario, clave, puerto y base: si cambias uno, cambialo en las dos.
DATABASE_URL=postgresql://snapit:cambiar_esta_clave@localhost:5432/snapit

# Servidor (#2)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TEST_DATABASE_URL=postgresql://snapit:cambiar_esta_clave@localhost:5432/snapit_test

# Autenticacion (#6)
# Obligatorio, minimo 32 caracteres. Va vacio a proposito: un valor de ejemplo quedaria publico en el repo.
# Para generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Correos (#7)
# Los links de los correos apuntan a la web (puerto de Vite en desarrollo).
URL_WEB=http://localhost:5173
# En desarrollo los correos van a Mailpit (docker compose up -d mailpit) y se ven en http://localhost:8025.
# Mailpit no pide usuario ni clave; un SMTP real, si. Con el puerto 465 la conexion va cifrada desde el inicio.
SMTP_HOST=localhost
SMTP_PUERTO=1025
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE="SnapIt <no-responder@snapit.local>"

# Fotos de los reportes (#13)
# Carpeta donde se guardan, relativa a server/ (no se versiona). En Docker es un volumen.
FOTOS_DIR=fotos
# Tamano maximo de cada foto. nginx (web/nginx.conf) acepta hasta 20 MB: tiene que ser menor.
FOTO_MAX_MB=10

# Direccion y barrio de cada reporte (#48)
# El servicio publico admite una consulta por segundo y pide un User-Agent que identifique a la aplicacion.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="SnapIt/1.0 (+https://github.com/JuanEspinoza8/SNAPIT)"

# Puntos de interés de OpenStreetMap (#60)
# Solo lo usa npm run importar:puntos. El servicio público se satura seguido: si falla, se puede cargar la
# respuesta guardada en db/datos/ con npm run importar:puntos -- --sin-conexion.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Inteligencia artificial: Claude, de Anthropic (#56)
# La clave se saca en https://platform.claude.com (API Keys). Va vacía a propósito: es un secreto y cada
# llamada se cobra. Sin clave el servidor arranca igual, pero las funciones de IA responden "no disponible".
ANTHROPIC_API_KEY=
# Modelo para todas las consultas. Haiku es el más barato y rápido; para más precisión, claude-sonnet-5-5.
IA_MODELO=claude-haiku-5-5
# Tiempo máximo (ms) de cada consulta, contando el reintento.
IA_TIMEOUT_MS=30000
