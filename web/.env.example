# Variables de la web. Se copian a web/.env para el desarrollo (web/.env no se
# versiona; web/.env.example sí). Solo llegan al navegador las que empiezan con VITE_.

# URL de la API, terminada en /api. Por defecto es /api: en desarrollo la
# reenvía el proxy de Vite (vite.config.ts) y en la demo nginx. El servidor no
# habilita CORS (docs/api.md), así que la web siempre habla por el mismo origen.
# Solo cambiala si hace falta apuntar a otro lado:
# VITE_API_URL=/api

# Con 1, la API se simula con MSW (src/compartido/red/mocks) mientras el
# servidor no tenga los endpoints. Sin la variable, se llama al servidor real.
# Solo funciona con npm run dev: el build de producción la ignora.
VITE_MSW=0
